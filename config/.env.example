# Naxis configuration template. Copy to config/.env (`make setup`) and fill in.
# docker-compose reads this path via env_file; values are typed in
# backend/config/settings.py. Never commit the real config/.env.

# Service
SERVICE_NAME=naxis
LOG_LEVEL=INFO
ENVIRONMENT=development

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
# Shared secret for machine clients. Empty disables auth (local dev only).
API_KEY=

# PostgreSQL. POSTGRES_PASSWORD is required — compose aborts without it.
# DATABASE_URL is read directly by the connection pool; setting only
# POSTGRES_HOST leaves the pool pointed at localhost.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://naxis:change-me@postgres:5432/naxis
# Enforce TLS on the pool. Required by every managed Postgres.
POSTGRES_SSL=false

# Redis — real-time notifications only, never an event bus. Required by compose.
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_ENABLED=true

# Keycloak OIDC. Realm is owned by the Keycloak team; we implement the client.
KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=naxis
KEYCLOAK_CLIENT_ID=naxis-platform
KEYCLOAK_CLIENT_SECRET=

# Collector loop
COLLECTOR_INTERVAL=60

# Every vendor is feature-flagged. A disabled vendor must never hard-fail.
# Juniper Mist
MIST_ENABLED=false
MIST_API_KEY=
MIST_ORG_ID=
MIST_BASE_URL=https://api.mist.com

# SD-WAN. sdwan_provider selects the active adapter: velocloud | silverpeak
SDWAN_PROVIDER=velocloud
VELOCLOUD_ENABLED=false
VELOCLOUD_URL=
VELOCLOUD_API_KEY=
VELOCLOUD_ENTERPRISE_ID=
VELOCLOUD_VERIFY_SSL=true
SILVERPEAK_ENABLED=false
SILVERPEAK_HOST=
SILVERPEAK_API_KEY=

# Cisco DNAC
DNAC_ENABLED=false
DNAC_HOST=
DNAC_USERNAME=
DNAC_PASSWORD=
DNAC_VERIFY_SSL=true

# Arista WLC
ARISTA_WLC_ENABLED=false
ARISTA_WLC_HOST=
ARISTA_WLC_USERNAME=
ARISTA_WLC_PASSWORD=
ARISTA_WLC_VERIFY_SSL=true

# Aruba Central
ARUBA_CENTRAL_ENABLED=false
ARUBA_CENTRAL_BASE_URL=
ARUBA_CENTRAL_CLIENT_ID=
ARUBA_CENTRAL_CLIENT_SECRET=
ARUBA_CENTRAL_CUSTOMER_ID=

# Aruba ClearPass (NAC). Auth result and method only — never credentials.
CLEARPASS_ENABLED=false
CLEARPASS_HOST=
CLEARPASS_CLIENT_ID=
CLEARPASS_CLIENT_SECRET=

# Path segments, not topology nodes.
CLOUDFLARE_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Aggregate tunnel health only. Per-user browsing history is out of scope.
NETSKOPE_ENABLED=false
NETSKOPE_TENANT_URL=
NETSKOPE_API_TOKEN=

# SNMP polling
SNMP_ENABLED=false
SNMP_COMMUNITY=
SNMP_PORT=161
SNMP_TIMEOUT=10
SNMP_RETRIES=2
SNMP_TARGETS=

# SNMP trap receiver (privileged port: needs root or CAP_NET_BIND_SERVICE)
SNMP_TRAP_ENABLED=false
SNMP_TRAP_HOST=0.0.0.0
SNMP_TRAP_PORT=162

# Syslog receiver
SYSLOG_ENABLED=false
SYSLOG_HOST=0.0.0.0
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=1514

# Correlation. time_window is in seconds and is a correctness dependency:
# clock drift between Naxis and vendor timestamps mis-buckets events.
CORRELATION_TIME_WINDOW=300
CORRELATION_MIN_EVENTS=2
CORRELATION_TOPOLOGY_CASCADE=true

# Retention. events is a working buffer for correlation, not an archive —
# vendor consoles are the archive.
EVENT_RETENTION_DAYS=2
INCIDENT_RETENTION_DAYS=180
RAW_EVENT_DEBUG_DAYS=7
# Auto-resolve open incidents with no new evidence for this long. 0 = never.
INCIDENT_STALE_HOURS=48

# Collector failure alerting
NOTIFICATION_ENABLED=false
NOTIFICATION_SLACK_WEBHOOK=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM=naxis@localhost
NOTIFICATION_EMAIL_TO=
NOTIFICATION_DEDUP_MINUTES=15
NOTIFICATION_MIN_FAILURES=3
NOTIFICATION_MIN_SKIPS=10

# Frontend. NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time, so
# a hosted deployment must be rebuilt with its real URL — setting this only at
# runtime never reaches the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Host port mappings
API_HOST_PORT=8000
WEB_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
